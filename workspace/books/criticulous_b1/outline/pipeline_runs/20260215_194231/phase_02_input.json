          "chapter_id": 1,
          "title": "0% Accuracy, 100% Luck",
          "goal": "Survive the Isekai tutorial by exploiting a glitch in the 'Luck' stat that guarantees critical hits on missed attacks.",
          "chapter_role": "hook",
          "stakes_shift": "From a confused casualty to a high-variance glass cannon with a target on his back.",
          "bridge": {
            "from_prev": "Protagonist dies in a mundane accident and wakes up in the System's arrival lounge.",
            "to_next": "The protagonist realizes his 'broken' build requires specific gear to be viable outside the tutorial zone."
          },
          "pacing": {
            "intensity": 4,
            "tempo": "steady",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 2,
          "title": "The Math of Murder",
          "goal": "Acquire the 'Running Shoes of the Coward' to enable the 'Hit & Run' portion of the build.",
          "chapter_role": "setup",
          "stakes_shift": "Transition from accidental survival to intentional exploitation of game mechanics.",
          "bridge": {
            "from_prev": "Exiting the tutorial with a mountain of 'Missed' critical damage data.",
            "to_next": "A local dungeon offers the perfect testing ground for high-speed kiting."
          },
          "pacing": {
            "intensity": 2,
            "tempo": "slow_burn",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 3,
          "title": "Aggro Management for Idiots",
          "goal": "Clear the Wildwood Dungeon solo by kiting the boss into its own traps using superior movement speed.",
          "chapter_role": "trial",
          "stakes_shift": "Local fame grows, attracting the attention of both fans and jealous 'balanced' players.",
          "bridge": {
            "from_prev": "Equipped with speed-boosting gear and a snarky attitude.",
            "to_next": "The 'Balance Committee'\u2014a guild of enforcers\u2014decides his build is an illegal exploit."
          },
          "pacing": {
            "intensity": 3,
            "tempo": "steady",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 4,
          "title": "A Critical Error",
          "goal": "Escape an ambush by the Balance Committee by leaning into the most absurd physics glitches possible.",
          "chapter_role": "reversal",
          "stakes_shift": "The protagonist goes from being a player to a fugitive within the System.",
          "bridge": {
            "from_prev": "Winning too much and drawing the wrong kind of administrative eyes.",
            "to_next": "Realizing he can't outrun a whole guild alone; he needs a meat shield."
          },
          "pacing": {
            "intensity": 5,
            "tempo": "rush",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 5,
          "title": "The Glass Cannon Brigade",
          "goal": "Recruit a disgraced former tank who has the only 'Unstoppable' skill capable of keeping up with the protagonist.",
          "chapter_role": "alliance",
          "stakes_shift": "Individual survival becomes a tactical partnership with shared risks.",
          "bridge": {
            "from_prev": "Hiding in the slums of a major trade hub while being hunted.",
            "to_next": "Taking the fight to the Balance Committee's main resource node."
          },
          "pacing": {
            "intensity": 3,
            "tempo": "steady",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 6,
          "title": "Running the Numbers",
          "goal": "Infiltrate the Spire of Math to delete the protagonist's 'Exploit' flag before the System auto-bans him.",
          "chapter_role": "climax",
          "stakes_shift": "The protagonist's existence in this world is at stake; it's 'fix the flag' or 'get deleted'.",
          "bridge": {
            "from_prev": "A high-speed chase across the plains leading to the Spire.",
            "to_next": "The System's logic is rewritten, but the consequences are unpredictable."
