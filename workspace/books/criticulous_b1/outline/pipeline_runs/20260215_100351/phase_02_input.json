    "outline_spine_v1": {
      "schema_version": "spine_v1",
      "chapters": [
        {
          "chapter_id": 1,
          "title": "The Critical Error",
          "goal": "Protagonist Artie is isekai'd during a server crash and discovers his 'Crit' stat is bugged to 1000% while his HP is locked at 1.",
          "chapter_role": "hook",
          "stakes_shift": "From a mundane gamer to a high-stakes survivalist where a single breeze could kill him, but a sneeze could kill a god.",
          "bridge": {
            "from_prev": "Artie is playing a dying MMO in his apartment.",
            "to_next": "Artie must find gear to protect his 1 HP before the starter zone mobs aggro."
          },
          "pacing": {
            "intensity": 4,
            "tempo": "steady",
            "expected_scene_count": 8
          }
        },
        {
          "chapter_id": 2,
          "title": "Min-Maxing the Apocalypse",
          "goal": "Artie exploits a terrain glitch to one-shot a high-level field boss, gaining legendary loot and the attention of the System's 'Anti-Cheat' logic.",
          "chapter_role": "setup",
          "stakes_shift": "From a desperate survivor to an accidental powerhouse with resources that make him a target for every guild in the zone.",
          "bridge": {
            "from_prev": "Artie has survived the initial transition and confirmed his bugged stats.",
            "to_next": "Artie needs to reach the capital to fence his loot without being identified as a 'cheater'."
          },
          "pacing": {
            "intensity": 3,
            "tempo": "steady",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 3,
          "title": "The Escort Mission from Hell",
          "goal": "Artie hires a disgraced tank, Silus, to protect him on the road, while pretending to be a high-level 'Glass Cannon' build rather than a bugged level 1.",
          "chapter_role": "journey",
          "stakes_shift": "From a solo runner to a team leader whose life depends on a bodyguard who doesn't know the true fragility of his employer.",
          "bridge": {
            "from_prev": "Artie has the loot but lacks the durability to travel the main roads.",
            "to_next": "A forced detour into a mid-level dungeon to avoid a bounty hunter blockade."
          },
          "pacing": {
            "intensity": 2,
            "tempo": "slow_burn",
            "expected_scene_count": 9
          }
        },
        {
          "chapter_id": 4,
          "title": "Vault of the Bugged Boss",
          "goal": "The party enters the 'Sunken Archive' dungeon, where Artie's crits accidentally bypass the boss's invulnerability phases, breaking the dungeon logic.",
          "chapter_role": "trial",
          "stakes_shift": "The group realizes Artie isn't just strong, he's 'breaking the world,' shifting the threat from monsters to the System itself.",
          "bridge": {
            "from_prev": "The party is trapped in a dungeon meant for players twenty levels higher.",
            "to_next": "The System issues a 'Hotfix Quest' specifically targeting Artie's location."
          },
          "pacing": {
            "intensity": 4,
            "tempo": "steady",
            "expected_scene_count": 11
          }
        },
        {
          "chapter_id": 5,
          "title": "Patch 0.0.1: The End of Days",
          "goal": "Artie discovers that the 'System' is a dying god's attempt to debug reality, and his bugged crit is actually a fragment of the god's administrative power.",
          "chapter_role": "revelation",
          "stakes_shift": "The quest changes from personal survival to preventing a 'Server Wipe' that would delete the entire world.",
          "bridge": {
            "from_prev": "Artie survives the dungeon but is confronted by a System Avatar.",
            "to_next": "Artie must rally his skeptical party to attack the 'Admin Citadel' before the wipe timer hits zero."
          },
          "pacing": {
            "intensity": 3,
            "tempo": "steady",
            "expected_scene_count": 10
          }
        },
        {
          "chapter_id": 6,
          "title": "Aggro Peak",
          "goal": "Artie and his allies storm the Citadel, using every exploit and cheese-tactic Artie can remember from his gaming days to bypass elite guards.",
          "chapter_role": "confrontation",
          "stakes_shift": "Artie loses his anonymity; he is now the most wanted 'Anomaly' in existence, fighting the very rules of the world.",
          "bridge": {
            "from_prev": "The party begins their final ascent, pursued by the world's top guilds who want Artie's 'bounty'.",
            "to_next": "Artie reaches the core processor where the 'Admin' awaits."
          },
          "pacing": {
            "intensity": 5,
            "tempo": "rush",
            "expected_scene_count": 12
          }
        },
        {
          "chapter_id": 7,
          "title": "Zero Day Exploit",
          "goal": "Artie faces the final Admin Avatar, winning not through raw power, but by forcing a 'Divide by Zero' error using his 1000% crit against a 0-HP reflecting shield.",
          "chapter_role": "climax",
          "stakes_shift": "Artie rewrites the system rules to stabilize the world, losing his 'god-crit' but gaining a permanent, balanced place in the new reality.",
          "bridge": {
            "from_prev": "The world begins to de-rez as the wipe timer reaches one second.",
            "to_next": "The world is saved; Artie is just a regular player now, but with the best stories in the tavern."
          },
          "pacing": {
            "intensity": 5,
            "tempo": "rush",
            "expected_scene_count": 10
          }
        }
      ]
