    "text": "{\n  \"schema_version\": \"1.1\",\n  \"characters\": [\n    {\n      \"character_id\": \"char_rhea\",\n      \"name\": \"Rhea\",\n      \"intro\": {\n        \"chapter\": 1,\n        \"scene\": 1\n      },\n      \"role\": \"protagonist\"\n    },\n    {\n      \"character_id\": \"char_vex\",\n      \"name\": \"Vex\",\n      \"intro\": {\n        \"chapter\": 3,\n        \"scene\": 1\n      },\n      \"role\": \"system clerk\"\n    },\n    {\n      \"character_id\": \"char_artie\",\n      \"name\": \"Artie\",\n      \"intro\": {\n        \"chapter\": 3,\n        \"scene\": 1\n      },\n      \"role\": \"desperate arrival\"\n    }\n  ],\n  \"chapters\": [\n    {\n      \"chapter_id\": 3,\n      \"title\": \"Mutual Damage\",\n      \"goal\": \"Form a reluctant alliance with a local familiar/clerk and another trapped arrival based on shared incentives rather than trust.\",\n      \"chapter_role\": \"alliance\",\n      \"stakes_shift\": \"From solo survival to managing the liabilities and benefits of a party.\",\n      \"bridge\": {\n        \"from_prev\": \"Rhea's economic exploit gives her leverage to recruit.\",\n        \"to_next\": \"The new party's combined skills allow them to analyze the quest board's underlying math.\"\n      },\n      \"pacing\": {\n        \"intensity\": 3,\n        \"tempo\": \"steady\",\n        \"expected_scene_count\": 6\n      },\n      \"sections\": [\n        {\n          \"section_id\": 1,\n          \"title\": \"Unwanted Attention\",\n          \"intent\": \"Rhea's economic exploit draws the attention of a desperate fellow arrival and a cynical, low-level system clerk.\",\n          \"end_condition\": \"Rhea is cornered by the clerk and the arrival, forcing a tense negotiation over her exploit methodology.\",\n          \"section_role\": \"setup\",\n          \"target_scene_count\": 2,\n          \"status\": \"draftable\",\n          \"scenes\": [\n            {\n              \"scene_id\": 1,\n              \"summary\": \"Rhea is at the Ashwood Deposit Node, reviewing her newly acquired copper credits. Her unusual transaction logs trigger an automated flag, drawing the attention of Vex, a cynical, overworked local system clerk who manifests to audit her. Meanwhile, Artie, a battered arrival who has been watching her bypass the stamina tax, approaches her from the shadows.\",\n              \"type\": \"social\",\n              \"outcome\": \"Rhea's exploit is discovered by two separate parties, trapping her at the deposit node.\",\n              \"characters\": [\n                \"char_rhea\",\n                \"char_vex\",\n                \"char_artie\"\n              ],\n              \"introduces\": [\n                \"char_vex\",\n                \"char_artie\"\n              ],\n              \"location_start_label\": \"Ashwood Deposit Node\",\n              \"location_end_label\": \"Ashwood Deposit Node\",\n              \"location_start\": \"Standing before the rusted System deposit node.\",\n              \"location_end\": \"Cornered at the rusted System deposit node.\",\n              \"handoff_mode\": \"direct_continuation\",\n              \"constraint_state\": \"detained\",\n              \"transition_in_text\": \"Rhea stands before the rusted System deposit node, watching the digital counter tick upward as her untaxed copper credits register in the local ledger.\",\n              \"transition_in_anchors\": [\n                \"rusted System deposit node\",\n                \"digital counter\",\n                \"untaxed copper credits\"\n              ],\n              \"transition_out_text\": \"Rhea backs away from the deposit slot as a holographic clerk materializes on her left and a bruised man steps out of the ash-choked brush on her right.\",\n              \"transition_out_anchors\": [\n                \"deposit slot\",\n                \"holographic clerk\",\n                \"ash-choked brush\"\n              ],\n              \"hands_off_to\": \"3:2\"\n            },\n            {\n              \"scene_id\": 2,\n              \"summary\": \"Cornered between Vex's threat of an administrative ban and Artie's desperate plea for survival tips, Rhea realizes she cannot fight them both. Instead, she pivots, offering to share the exploit if they form a party, leveraging Vex's system access and Artie's muscle.\",\n              \"type\": \"social\",\n              \"outcome\": \"Rhea is cornered by the clerk and the arrival, forcing a tense negotiation over her exploit methodology.\",\n              \"characters\": [\n                \"char_rhea\",\n                \"char_vex\",\n                \"char_artie\"\n              ],\n              \"consumes_outcome_from\": \"3:1\",\n              \"location_start_label\": \"Ashwood Deposit Node\",\n              \"location_end_label\": \"Ashwood Deposit Node\",\n              \"location_start\": \"Cornered at the rusted System deposit node.\",\n              \"location_end\": \"Standing around a projected party interface window at the deposit node.\",\n              \"handoff_mode\": \"direct_continuation\",\n              \"constraint_state\": \"detained\",\n              \"transition_in_text\": \"Trapped between the glowing avatar of the system clerk and the desperate arrival, Rhea tightens her grip on her heavy masonry bludgeon.\",\n              \"transition_in_anchors\": [\n                \"glowing avatar\",\n                \"desperate arrival\",\n                \"heavy masonry bludgeon\"\n              ],\n              \"transition_out_text\": \"Rhea lowers her weapon and taps the rusted terminal chassis, projecting a party interface window between the three of them to begin the negotiation.\",\n              \"transition_out_anchors\": [\n                \"lowered weapon\",\n                \"rusted terminal chassis\",\n                \"party interface window\"\n              ],\n              \"hands_off_to\": \"3:3\",\n              \"end_condition_echo\": \"Rhea is cornered by the clerk and the arrival, forcing a tense negotiation over her exploit methodology.\"\n            }\n          ]\n        },\n        {\n          \"section_id\": 2,\n          \"title\": \"A Test of Synergy\",\n          \"intent\": \"The trio tests a joint venture, combining Rhea's exploit with the arrival's combat skill and the clerk's limited system access.\",\n          \"end_condition\": \"The newly formed party successfully completes a rigged local quest with zero net loss to their resources.\",\n          \"section_role\": \"action\",\n          \"target_scene_count\": 2,\n          \"status\": \"stub\",\n          \"scenes\": []\n        },\n        {\n          \"section_id\": 3,\n          \"title\": \"The Liability Contract\",\n          \"intent\": \"Formalize the party alliance using Rhea's strict, loophole-free legal wording to prevent future betrayal.\",\n          \"end_condition\": \"The System registers the party under a custom, highly restrictive liability contract.\",\n          \"section_role\": \"resolution\",\n          \"target_scene_count\": 2,\n          \"status\": \"stub\",\n          \"scenes\": []\n        }\n      ]\n    }\n  ]\n}",
